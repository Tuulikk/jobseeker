    });

    let (db_ext, ui_ext, rt_ext, rd_ext) = (db.clone(), ui.as_weak(), rt.clone(), refresh_dict.clone());
    ui.on_extract_dictionary(move || {
        let (db, ui_weak, rd) = (db_ext.clone(), ui_ext.clone(), rd_ext.clone());
        rt_ext.spawn(async move {
            if let Ok(ids) = db.list_documents().await {
                for id in ids {
                    if let Ok(Some(json)) = db.get_document(&id).await {
                        if let Ok(doc) = serde_json::from_str::<crate::models::UserDocument>(&json) {
                            for word in doc.content.split_whitespace() {
                                let clean = word.trim_matches(|c: char| !c.is_alphanumeric());
                                if clean.len() > 3 && clean.chars().any(|c| c.is_uppercase()) { let _ = db.save_dictionary_entry(clean, "Extraherad").await; }
                            }
                        }
                    }
                }
            }
            rd();
        });
    });

    let (db_sd, rt_sd, rd_sd) = (db.clone(), rt.clone(), refresh_docs.clone());
    ui.on_save_doc(move |id, content| {
        let (db, id_str, content_str, rd) = (db_sd.clone(), id.to_string(), content.to_string(), rd_sd.clone());
        rt_sd.spawn(async move {
            if let Ok(Some(json)) = db.get_document(&id_str).await {
                if let Ok(mut doc) = serde_json::from_str::<crate::models::UserDocument>(&json) {
                    doc.content = content_str; doc.version += 1;
                    if let Ok(upd) = serde_json::to_string(&doc) { let _ = db.save_document(&id_str, &upd).await; rd(); }
                }
            }
        });
    });

    let (db_sel, ui_sel, rt_sel) = (db.clone(), ui.as_weak(), rt.clone());
    ui.on_select_doc(move |id| {
        let (db, ui_weak, id_str) = (db_sel.clone(), ui_sel.clone(), id.to_string());
        rt_sel.spawn(async move {
            if let Ok(Some(json)) = db.get_document(&id_str).await {
                if let Ok(doc) = serde_json::from_str::<crate::models::UserDocument>(&json) {
                    let content = doc.content;
                    let _ = slint::invoke_from_event_loop(move || { if let Some(ui) = ui_weak.upgrade() { ui.set_selected_doc_content(content.into()); } });
                }
            }
        });
    });

    let (db_imp, ui_imp, rt_imp, rd_imp) = (db.clone(), ui.as_weak(), rt.clone(), refresh_docs.clone());
    ui.on_import_doc(move || {
        let (db, ui_weak, rt, rd) = (db_imp.clone(), ui_imp.clone(), rt_imp.clone(), rd_imp.clone());
        #[cfg(not(target_os = "android"))]
        {
            if let Some(path) = rfd::FileDialog::new().add_filter("Dokument", &["pdf", "docx", "txt", "md"]).pick_file() {
                rt.spawn(async move {
                    if let Ok(content) = crate::extractor::extract_text(&path) {
                        let name = path.file_name().unwrap_or_default().to_string_lossy().into_owned();
                        let doc = crate::models::UserDocument { id: chrono::Utc::now().timestamp_millis().to_string(), name, content, doc_type: crate::models::DocumentType::CV, created_at: chrono::Utc::now(), version: 1 };
                        if let Ok(json) = serde_json::to_string(&doc) { let _ = db.save_document(&doc.id, &json).await; rd(); }
                    }
                });
            }
        }
    });

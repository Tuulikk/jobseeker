import { Button, LineEdit, ScrollView, TextEdit, CheckBox, HorizontalBox, VerticalBox, TabWidget } from "std-widgets.slint";
import { ProfilePage, DocEntry } from "ProfilePage.slint";
import { KnowledgePage, DictEntry } from "KnowledgePage.slint";

export struct KeywordStat {
    name: string,
    count: int,
}

export struct FolderEntry {
    name: string,
    path: string,
}

export struct LogEntry {
    level: string,
    message: string,
    timestamp: string,
}

export struct JobEntry {
    id: string,
    title: string,
    employer: string,
    location: string,
    description: string,
    date: string,
    apply_url: string,
    rating: int,
    status: int, // 0=New, 1=Rejected, 2=Saved, 3=ThumbsUp, 4=Applied
    status_text: string,
}

export struct AppSettings {
    keywords: string,
    blacklist_keywords: string,
    locations_p1: string,
    locations_p2: string,
    locations_p3: string,
    my_profile: string,
    ollama_url: string,
    sync_path: string,
    app_min_count: int,
    app_goal_count: int,
    show_motivation: bool,
    main_cv_id: string,
    show_dev_logs: bool,
}

export component FolderPicker inherits Rectangle {
    in property <[FolderEntry]> entries;
    in property <string> current-path;
    callback select-folder(string);
    callback create-folder(string);
    callback go-back;
    callback cancel;
    callback confirm;

    background: #1a1a1a;
    border-width: 1px;
    border-color: #333;

    VerticalLayout {
        padding: 15px;
        spacing: 10px;
        
        HorizontalLayout {
            spacing: 10px;
            Text { text: "Bläddra: " + root.current-path; color: #fff; font-size: 14px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Upp"; clicked => { root.go-back(); } }
        }

        HorizontalLayout {
            spacing: 10px;
            new-folder-input := LineEdit { placeholder-text: "Mappnamn..."; horizontal-stretch: 1; }
            Button { 
                text: "Ny mapp"; 
                enabled: new-folder-input.text != "";
                clicked => { 
                    root.create-folder(new-folder-input.text);
                    new-folder-input.text = "";
                } 
            }
        }

        Rectangle {
            background: #000;
            vertical-stretch: 1;
            ScrollView {
                VerticalLayout {
                    spacing: 2px;
                    for entry in root.entries: Rectangle {
                        height: 40px;
                        background: touch.pressed ? #333 : #000;
                        touch := TouchArea {
                            clicked => { root.select-folder(entry.path); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 10px;
                            Text { text: "📁"; vertical-alignment: center; }
                            Text { text: entry.name; color: #eee; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 15px;
            alignment: end;
            Button { text: "Avbryt"; clicked => { root.cancel(); } }
            Button { text: "Välj denna mapp"; primary: true; clicked => { root.confirm(); } }
        }
    }
}

component LogPage inherits Rectangle {
    in property <[LogEntry]> logs;
    in property <string> filter-level: "ALL";
    callback refresh;
    callback copy-logs;
    callback save-to-file;
    callback set-filter(string);

    background: #121212;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;

        HorizontalLayout {
            Text { text: "Systemloggar"; font-size: 24px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
            Button { text: "Uppdatera"; clicked => { root.refresh(); } }
        }

        HorizontalLayout {
            spacing: 10px;
            Button { text: "Alla"; primary: root.filter-level == "ALL"; clicked => { root.set-filter("ALL"); } }
            Button { text: "Info"; primary: root.filter-level == "INFO"; clicked => { root.set-filter("INFO"); } }
            Button { text: "Varning"; primary: root.filter-level == "WARN"; clicked => { root.set-filter("WARN"); } }
            Button { text: "Fel"; primary: root.filter-level == "ERROR"; clicked => { root.set-filter("ERROR"); } }
        }

        Rectangle {
            background: #000;
            border-radius: 4px;
            vertical-stretch: 1;
            ScrollView {
                VerticalLayout {
                    padding: 5px;
                    spacing: 0px;
                    for entry in root.logs: Text {
                        text: "[" + entry.timestamp + "] " + entry.level + ": " + entry.message;
                        color: entry.level == "ERROR" ? #ff4444 : (entry.level == "WARN" ? #ffbb33 : #00ff00);
                        font-family: "monospace";
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; } // This pushes everything up
                }
            }
        }

        HorizontalLayout {
            spacing: 15px;
            Button { text: "Kopiera allt"; clicked => { root.copy-logs(); } }
            Button { text: "Spara till fil"; clicked => { root.save-to-file(); } }
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 16px;
    in property <bool> active: false;
    in property <bool> danger: false;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 4px;

    Rectangle {
        background: active ? (danger ? #802020 : #4a90e2) : touch.pressed ? #3a3a3a : touch.has-hover ? #2d2d2d : transparent;
        width: 100%;
        height: 100%;
        border-radius: 4px;
    }

    Image {
        source: icon;
        width: icon-size;
        height: icon-size;
        colorize: active ? (danger ? #ff6666 : #ffffff) : #ffffff;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component JobListItem inherits Rectangle {
    in property <JobEntry> job;
    in property <bool> selected: false;
    callback clicked;

    height: 68px;
    background: selected ? #2d2d3a : touch.pressed ? #2d2d2d : touch.has-hover ? #252525 : transparent;
    border-radius: 4px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    container := Rectangle {
        Rectangle {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: 4px;
            height: 40px;
            background: job.status == 4 ? #00ff00 : (job.status == 3 ? #00ffff : (job.status == 2 ? #ffd700 : #444444));
            border-radius: 2px;
        }

        Text {
            x: 22px;
            y: 16px;
            text: job.title;
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            width: parent.width - 100px;
            overflow: elide;
        }

        Text {
            x: 22px;
            y: 36px;
            text: job.employer + " • " + job.location;
            color: #999999;
            font-size: 12px;
            width: parent.width - 100px;
            overflow: elide;
        }

        Text {
            x: parent.width - self.width - 8px;
            y: 18px;
            text: job.date;
            color: #666666;
            font-size: 12px;
        }

        if job.status == 4 : Text {
            x: parent.width - self.width - 8px;
            y: 36px;
            text: "SÖKT";
            color: #00ff00;
            font-size: 12px;
            font-weight: 700;
        }
    }
}

component InboxPane inherits VerticalLayout {
    in property <[JobEntry]> jobs;
    in property <bool> searching;
    in-out property <string> status-msg: "Redo";
    in-out property <int> selected-index: -1;
    in-out property <int> active-filter: 0;
    in-out property <string> active-month: "2026-01";
    in-out property <string> active-month-display: "Januari 2026";
    in-out property <int> applied-count: 0;
    in property <int> app-min-count: 6;
    in property <int> app-goal-count: 12;

    callback search-pressed(string);
    callback search-prio(int);
    callback job-selected(string, int);
    callback month-offset(int);

    padding: 10px;
    spacing: 5px;

    Rectangle {
        height: 24px;
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.applied-count < root.app-min-count 
                    ? (root.app-min-count - root.applied-count) + " kvar till minimum"
                    : (root.applied-count < root.app-goal-count 
                        ? (root.app-goal-count - root.applied-count) + " kvar till målet"
                        : "Målet är nått! 🎉");
                color: root.applied-count < root.app-min-count ? #ff6666 : (root.applied-count < root.app-goal-count ? #ffd700 : #00ff00);
                font-size: 13px;
                font-weight: 700;
            }
            Text {
                text: "Totalt sökta: " + root.applied-count;
                color: #888888;
                font-size: 13px;
            }
        }
    }

    Rectangle {
        background: #1a1a1a;
        border-radius: 8px;
        preferred-height: 160px;

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;
                search-input := LineEdit {
                    placeholder-text: "Fri sökning...";
                    accepted => { root.search-pressed(self.text); }
                }
                Button {
                    text: root.searching ? "..." : "Sök";
                    width: 60px;
                    enabled: !root.searching;
                    clicked => { root.search-pressed(search-input.text); }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: space-between;
                Button { text: root.searching ? "..." : "P1"; width: 45px; enabled: !root.searching; clicked => { root.status-msg = "Laddar Prio 1..."; root.search-prio(1); } }
                Button { text: root.searching ? "..." : "P2"; width: 45px; enabled: !root.searching; clicked => { root.status-msg = "Laddar Prio 2..."; root.search-prio(2); } }
                Button { text: root.searching ? "..." : "P3"; width: 45px; enabled: !root.searching; clicked => { root.status-msg = "Laddar Prio 3..."; root.search-prio(3); } }
                Rectangle { width: 10px; } // Spacer
                IconButton { icon: @image-url("../assets/icons/bookmark-star-fill.svg"); active: root.active-filter == 2; clicked => { root.active-filter = (root.active-filter == 2 ? 0 : 2); } }
                IconButton { icon: @image-url("../assets/icons/hand-thumbs-up-fill.svg"); active: root.active-filter == 3; clicked => { root.active-filter = (root.active-filter == 3 ? 0 : 3); } }
                IconButton { icon: @image-url("../assets/icons/check-circle-fill.svg"); active: root.active-filter == 4; clicked => { root.active-filter = (root.active-filter == 4 ? 0 : 4); } }
            }

            HorizontalLayout {
                height: 32px;
                alignment: center;
                spacing: 12px;
                IconButton { icon: @image-url("../assets/icons/chevron-left.svg"); clicked => { root.month-offset(-1); } }
                Text {
                    text: root.active-month-display;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    color: #ffffff;
                    font-weight: 700;
                    width: 140px;
                }
                IconButton { icon: @image-url("../assets/icons/chevron-right.svg"); clicked => { root.month-offset(1); } }
            }
        }
    }

    Rectangle {
        background: #1e1e1e;
        border-radius: 4px;
        vertical-stretch: 1;
        clip: true;

        ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 4px;
                padding: 4px;
                padding-right: 16px;

                for job[idx] in jobs : JobListItem {
                    visible: root.active-filter == 0 || job.status == root.active-filter;
                    height: self.visible ? 72px : 0px;
                    job: job;
                    selected: idx == root.selected-index;
                    clicked => { root.job-selected(job.id, idx); }
                }
            }
        }

        if jobs.length == 0 && !searching : Text {
            text: "Hittade inga annonser";
            color: #555555;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component JobDetailPane inherits Rectangle {
    in property <JobEntry> job;
    callback close;
    callback action(string);
    callback copy(string);

    background: #1e1e1e;
    clip: true;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 20px;
        spacing: 15px;

        header_row := HorizontalLayout {
            height: 32px;
            IconButton {
                icon: @image-url("../assets/icons/chevron-left.svg");
                clicked => { root.close(); }
            }
            Text { text: " Tillbaka"; vertical-alignment: center; color: #888888; }
            Rectangle { } // Spacer
        }

        title_text := Text {
            text: job.title;
            font-size: 20px;
            font-weight: 700;
            color: #ffffff;
            wrap: word-wrap;
        }

        if job.status == 4 : Rectangle {
            background: #1a2e1a;
            border-radius: 4px;
            border-width: 1px;
            border-color: #00ff00;
            height: 75px;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text { text: "KOPIERA TILL RAPPORT"; color: #00ff00; font-weight: 700; font-size: 9px; }
                HorizontalLayout {
                    spacing: 4px;
                    Button { text: "Företag"; clicked => { root.copy(job.employer); } }
                    Button { text: "Kommun"; clicked => { root.copy(job.location); } }
                    Button { text: "Titel"; clicked => { root.copy(job.title); } }
                }
            }
        }

        action_bar := HorizontalLayout {
            spacing: 10px;
            alignment: center;
            height: 40px;
            IconButton { icon: @image-url("../assets/icons/hand-thumbs-down-fill.svg"); icon-size: 20px; danger: true; clicked => { root.action("reject"); } }
            IconButton { icon: @image-url("../assets/icons/bookmark-star-fill.svg"); icon-size: 20px; active: job.status == 2; clicked => { root.action("save"); } }
            IconButton { icon: @image-url("../assets/icons/hand-thumbs-up-fill.svg"); icon-size: 20px; active: job.status == 3; clicked => { root.action("thumbsup"); } }
            IconButton { icon: @image-url("../assets/icons/check-circle-fill.svg"); icon-size: 20px; active: job.status == 4; clicked => { root.action("apply"); } }
            IconButton { 
                icon: @image-url("../assets/icons/clipboard-plus-fill.svg"); 
                icon-size: 20px; 
                active: job.apply_url != ""; 
                clicked => { if (job.apply_url != "") { root.action("apply_direct"); } } 
            }
            IconButton { icon: @image-url("../assets/icons/globe.svg"); icon-size: 20px; clicked => { root.action("open"); } }
        }

        Rectangle {
            vertical-stretch: 1;
            ScrollView {
                VerticalLayout {
                    padding-right: 25px;
                    Text {
                        text: job.description;
                        color: #dddddd;
                        font-size: 14px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                    }
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 40px;
    background: active ? #2d2d3a : touch.has-hover ? #252525 : transparent;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        Image {
            source: root.icon;
            width: 24px;
            height: 24px;
            colorize: root.active ? #4a90e2 : #888888;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.active ? #ffffff : #888888;
            font-size: 14px;
            font-weight: root.active ? 700 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component StatisticsPage inherits Rectangle {
    in property <int> applied-count;
    in property <int> bookmarked-count;
    in property <int> thumbsup-count;
    in property <int> rejected-count;
    in property <int> total-ads-count;
    in property <string> active-month-display;
    in property <[KeywordStat]> top-keywords;
    
    in-out property <bool> include-jobs: true;
    in-out property <bool> include-params: true;
    in-out property <bool> include-analysis: false;

    callback export(string, string, bool, bool, bool);

    background: #121212;

    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        alignment: start;

        Text { text: "Statistik & Redovisning"; font-size: 24px; font-weight: 700; color: #ffffff; }
        
        Rectangle {
            background: #1a1a1a;
            border-radius: 8px;
            VerticalLayout {
                padding: 15px;
                spacing: 8px;
                Text { text: root.active-month-display; color: #4a90e2; font-weight: 700; }
                
                HorizontalLayout {
                    Text { text: "✅ Sökta jobb:"; color: #999; }
                    Rectangle { }
                    Text { text: root.applied-count; color: #00ff00; font-weight: 700; }
                }
                HorizontalLayout {
                    Text { text: "⭐ Bokmärkta:"; color: #999; }
                    Rectangle { }
                    Text { text: root.bookmarked-count; color: #ffd700; }
                }
                HorizontalLayout {
                    Text { text: "👍 Intressanta (Tumme upp):"; color: #999; }
                    Rectangle { }
                    Text { text: root.thumbsup-count; color: #00ffff; }
                }
                HorizontalLayout {
                    Text { text: "👎 Avvisade:"; color: #999; }
                    Rectangle { }
                    Text { text: root.rejected-count; color: #ff6666; }
                }
                
                Rectangle { height: 1px; background: #333; }

                HorizontalLayout {
                    Text { text: "📦 Totalt i inkorg:"; color: #999; }
                    Rectangle { }
                    Text { text: root.total-ads-count; color: #ffffff; }
                }

                if root.top-keywords.length > 0 : VerticalLayout {
                    spacing: 5px;
                    padding-top: 10px;
                    Text { text: "TOPP SÖKORD (NAPP)"; color: #888; font-size: 10px; }
                    for kw in root.top-keywords : HorizontalLayout {
                        Text { text: " • " + kw.name; color: #dddddd; font-size: 12px; }
                        Rectangle { }
                        Text { text: kw.count + " st"; color: #4a90e2; font-size: 12px; }
                    }
                }
            }
        }

        Text { text: "EXPORT & RAPPORT"; color: #4a90e2; font-weight: 700; font-size: 11px; }
        
        Rectangle {
            background: #1a1a1a;
            border-radius: 8px;
            VerticalLayout {
                padding: 15px;
                spacing: 15px;
                
                Text { text: "Välj vad som ska ingå:"; color: #888; font-size: 12px; }
                
                HorizontalLayout {
                    spacing: 10px;
                    CheckBox { text: "Sökta jobb & info"; checked: root.include-jobs; toggled => { root.include-jobs = self.checked; } }
                    CheckBox { text: "Sökparametrar (Prio/Ord)"; checked: root.include-params; toggled => { root.include-params = self.checked; } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    CheckBox { text: "Aktivitetsanalys"; checked: root.include-analysis; toggled => { root.include-analysis = self.checked; } }
                }

                Rectangle { height: 10px; }

                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Urklipp"; clicked => { root.export("clipboard", "text", root.include-jobs, root.include-params, root.include-analysis); } }
                    Button { text: "Spara Fil"; clicked => { root.export("file", "pdf", root.include-jobs, root.include-params, root.include-analysis); } }
                    Button { text: "E-post"; clicked => { root.export("email", "text", root.include-jobs, root.include-params, root.include-analysis); } }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

component SettingsPage inherits Rectangle {
    in-out property <AppSettings> settings;
    in property <string> system-logs;
    in property <string> log_file_path;
    in property <string> database_path;
    in property <string> last_api_request;
    callback save-settings(AppSettings);
    callback clear-logs;
    callback copy-text(string);
    callback db-action(string);
    callback pick-sync-path;

    background: #121212;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;

        Text { text: "Inställningar"; font-size: 24px; font-weight: 700; color: #ffffff; }

        ScrollView {
            VerticalLayout {
                width: 100%;
                spacing: 15px;
                padding-right: 25px;

                Text { text: "DATABASHANTERING (SYNK)"; color: #00ffff; font-weight: 700; font-size: 11px; }
                Rectangle {
                    background: #1a1a1a;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text { text: "Aktiv databas:"; color: #888; font-size: 12px; }
                        Text { text: root.database_path; color: #aaa; font-size: 12px; wrap: char-wrap; }
                        HorizontalLayout {
                            spacing: 10px;
                            Button { text: "Skapa Backup"; clicked => { root.db-action("backup"); } }
                            Button { text: "Synka Nu"; clicked => { root.db-action("sync"); } }
                        }
                        Rectangle { height: 10px; }
                        Text { text: "SYNKRAPP (Valfri):"; color: #888; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 10px;
                            sync-input := TextEdit {
                                text: root.settings.sync_path;
                                placeholder-text: "/path/to/sync/folder";
                                height: 40px;
                                font-size: 12px;
                            }
                            Button {
                                text: "Välj mapp";
                                clicked => { root.pick-sync-path(); }
                            }
                        }
                        Text { text: "Databasen kopieras hit automatiskt vid ändringar."; color: #666; font-size: 10px; }
                    }
                }

                Text { text: "SÖKORD"; color: #4a90e2; font-weight: 700; font-size: 11px; }
                keywords-input := TextEdit { text: root.settings.keywords; font-size: 12px; height: 80px; wrap: word-wrap; }
                blacklist-input := TextEdit { text: root.settings.blacklist_keywords; font-size: 12px; height: 60px; wrap: word-wrap; }

                Text { text: "PRIORITERADE OMRÅDEN"; color: #4a90e2; font-weight: 700; font-size: 11px; }
                loc-p1 := TextEdit { text: root.settings.locations_p1; font-size: 12px; height: 60px; wrap: word-wrap; }
                loc-p2 := TextEdit { text: root.settings.locations_p2; font-size: 12px; height: 60px; wrap: word-wrap; }
                loc-p3 := TextEdit { text: root.settings.locations_p3; font-size: 12px; height: 60px; wrap: word-wrap; }

                Text { text: "AI PROFIL"; color: #ffd700; font-weight: 700; font-size: 11px; }
                profile-input := TextEdit { text: root.settings.my_profile; height: 100px; wrap: word-wrap; }

                Text { text: "ANSÖKNINGSMÅL"; color: #00ff00; font-weight: 700; font-size: 11px; }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        Text { text: "Minimum"; color: #888; font-size: 10px; }
                        min-input := LineEdit { text: root.settings.app_min_count; placeholder-text: "6"; input-type: number; }
                    }
                    VerticalLayout {
                        Text { text: "Mål"; color: #888; font-size: 10px; }
                        goal-input := LineEdit { text: root.settings.app_goal_count; placeholder-text: "12"; input-type: number; }
                    }
                }
                CheckBox {
                    text: "Visa sporrande meddelanden";
                    checked: root.settings.show_motivation;
                    toggled => { root.settings.show_motivation = self.checked; }
                }
                CheckBox {
                    text: "Visa systemloggar i menyn";
                    checked: root.settings.show_dev_logs;
                    toggled => { 
                        root.settings.show_dev_logs = self.checked; 
                    }
                }

                Button {
                    text: "Spara Inställningar";
                    primary: true;
                    clicked => {
                        root.save-settings({
                            keywords: keywords-input.text,
                            blacklist_keywords: blacklist-input.text,
                            locations_p1: loc-p1.text,
                            locations_p2: loc-p2.text,
                            locations_p3: loc-p3.text,
                            my_profile: profile-input.text,
                            ollama_url: root.settings.ollama_url,
                            sync_path: sync-input.text,
                            app_min_count: min-input.text.to-float(),
                            app_goal_count: goal-input.text.to-float(),
                            show_motivation: root.settings.show_motivation,
                            main_cv_id: root.settings.main_cv_id,
                            show_dev_logs: root.settings.show_dev_logs
                        });
                    }
                }
            }
        }
    }
}

export component App inherits Window {
    title: "Jobseeker 2026";
    min-width: 380px;
    min-height: 500px;
    background: #121212;
    preferred-width: 900px;
    preferred-height: 800px;

    in-out property <int> selected-index: -1;
    in-out property <[JobEntry]> jobs: [];
    in-out property <bool> searching: false;
    in-out property <string> status-msg: "Redo";
    in-out property <int> current-tab: 0;
    in-out property <string> active-month: "2026-01";
    in-out property <string> active-month-display: "Januari 2026";
    in-out property <string> system-logs: "";
    in-out property <string> log_file_path: "";
    in-out property <string> database_path: "";
    in-out property <string> last_api_request: "";
    in-out property <int> applied-count: 0;
    in-out property <int> total-ads-count: 0;
    in-out property <int> bookmarked-count: 0;
    in-out property <int> thumbsup-count: 0;
    in-out property <int> rejected-count: 0;
    in-out property <[KeywordStat]> top-keywords: [];
    in-out property <[DocEntry]> documents: [];
    in-out property <[DictEntry]> dictionary: [];
    in-out property <string> selected-doc-content: "";
    in-out property <AppSettings> settings: { ollama_url: "http://localhost:11434/v1", app_min_count: 6, app_goal_count: 12, show_motivation: true, show_dev_logs: false };
    in-out property <bool> show-folder-picker: false;
    in-out property <[FolderEntry]> folder-entries: [];
    in-out property <string> current-folder-path: "";
    in-out property <[LogEntry]> static-logs: [];
    in-out property <string> log-filter: "ALL";

    callback search-pressed(string);
    callback search-prio(int);
    callback job-selected(string, int);
    callback job-action(string, string);
    callback copy-text(string);
    callback month_offset(int);
    callback save_settings(AppSettings);
    callback stats_requested();
    callback export_requested(string, string, bool, bool, bool);
    callback db_action(string);
    callback import_file();
    callback select_doc(string);
    callback save_doc(string, string);
    callback delete_doc(string);
    callback export_doc(string, string);
    callback analyze_match(string);
    callback set_as_main(string);
    callback add_entry(string, string);
    callback delete_entry(string);
    callback extract_from_docs();
    callback pick_sync_path();
    callback select_folder(string);
    callback create_folder(string, string);
    callback folder_go_back();
    callback request_logs(string);
    callback save_logs_to_file();

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;

            if current-tab == 0 : Rectangle {
                if root.width > 750px : HorizontalLayout {
                    InboxPane {
                        width: 350px;
                        jobs: root.jobs;
                        searching: root.searching;
                        status-msg: root.status-msg;
                        selected-index: root.selected-index;
                        active-month: root.active-month;
                        active-month-display: root.active-month-display;
                        applied-count: root.applied-count;
                        app-min-count: root.settings.app_min_count;
                        app-goal-count: root.settings.app_goal_count;
                        job-selected(id, idx) => { root.selected-index = idx; root.job-selected(id, idx); }
                        month-offset(off) => { root.month_offset(off); }
                        search-pressed(q) => { root.search-pressed(q); }
                        search-prio(p) => { root.search-prio(p); }
                    }
                    Rectangle { width: 1px; background: #333; }
                    if root.selected-index >= 0 : JobDetailPane {
                        job: root.jobs[root.selected-index];
                        close => { root.selected-index = -1; }
                        action(act) => { root.job-action(root.jobs[root.selected-index].id, act); }
                        copy(t) => { root.copy-text(t); }
                    }
                    if root.selected-index < 0 : Text { text: "Välj ett jobb"; color: #444; vertical-alignment: center; horizontal-alignment: center; }
                }

                if root.width <= 750px : Rectangle {
                    if root.selected-index < 0 : InboxPane {
                        jobs: root.jobs;
                        searching: root.searching;
                        status-msg: root.status-msg;
                        active-month: root.active-month;
                        active-month-display: root.active-month-display;
                        applied-count: root.applied-count;
                        app-min-count: root.settings.app_min_count;
                        app-goal-count: root.settings.app_goal_count;
                        job-selected(id, idx) => { root.selected-index = idx; root.job-selected(id, idx); }
                        month-offset(off) => { root.month_offset(off); }
                        search-pressed(q) => { root.search-pressed(q); }
                        search-prio(p) => { root.search-prio(p); }
                    }
                    if root.selected-index >= 0 : JobDetailPane {
                        job: root.jobs[root.selected-index];
                        close => { root.selected-index = -1; }
                        action(act) => { root.job-action(root.jobs[root.selected-index].id, act); }
                        copy(t) => { root.copy-text(t); }
                    }
                }
            }

            if root.current-tab == 1 : StatisticsPage {
                applied-count: root.applied-count;
                bookmarked-count: root.bookmarked-count;
                thumbsup-count: root.thumbsup-count;
                rejected-count: root.rejected-count;
                total-ads-count: root.total-ads-count;
                active-month-display: root.active-month-display;
                top-keywords: root.top-keywords;
                export(method, format, jobs, params, analysis) => { root.export_requested(method, format, jobs, params, analysis); }
            }

            if root.current-tab == 2 : SettingsPage {
                settings <=> root.settings;
                log_file_path: root.log_file_path;
                database_path: root.database_path;
                last_api_request: root.last_api_request;
                system-logs: root.system-logs;
                save-settings(s) => { root.save_settings(s); }
                db-action(act) => { root.db_action(act); }
                pick-sync-path() => { root.pick_sync_path(); }
            }

            if root.current-tab == 3 : ProfilePage {
                documents: root.documents;
                selected-doc-content <=> root.selected-doc-content;
                import-file() => { root.import_file(); }
                select-doc(id) => { root.select_doc(id); }
                save-doc(id, content) => { root.save_doc(id, content); }
                delete-doc(id) => { root.delete_doc(id); }
                export-doc(id, format) => { root.export_doc(id, format); }
                analyze-match(id) => { root.analyze_match(id); }
                set-as-main(id) => { root.set_as_main(id); }
            }

            if root.current-tab == 4 : KnowledgePage {
                entries: root.dictionary;
                add-entry(key, value) => { root.add_entry(key, value); }
                delete-entry(key) => { root.delete_entry(key); }
                extract-from-docs() => { root.extract_from_docs(); }
            }

            if root.current-tab == 5 : LogPage {
                logs: root.static-logs;
                filter-level: root.log-filter;
                refresh => { root.request_logs(root.log-filter); }
                set-filter(lvl) => { root.log-filter = lvl; root.request_logs(lvl); }
                copy-logs => { root.copy-text(root.system-logs); }
                save-to-file => { root.save_logs_to_file(); }
            }
        }

        Rectangle {
            height: 20px;
            background: #121212;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text { text: root.status-msg; color: #666666; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }

        Rectangle {
            height: 60px;
            background: #1a1a1a;
            ScrollView {
                viewport-width: 550px;
                HorizontalLayout {
                    alignment: center;
                    padding: 10px;
                    spacing: 15px;
                    TabButton { icon: @image-url("../assets/icons/inbox-fill.svg"); text: "Jobb"; active: root.current-tab == 0; clicked => { root.current-tab = 0; } }
                    TabButton { icon: @image-url("../assets/icons/justify.svg"); text: "Statistik"; active: root.current-tab == 1; clicked => { root.current-tab = 1; root.stats_requested(); } }
                    TabButton { icon: @image-url("../assets/icons/gear-fill.svg"); text: "Inställningar"; active: root.current-tab == 2; clicked => { root.current-tab = 2; } }
                    TabButton { icon: @image-url("../assets/icons/circle-fill.svg"); text: "Profil"; active: root.current-tab == 3; clicked => { root.current-tab = 3; } }
                    TabButton { icon: @image-url("../assets/icons/text-left.svg"); text: "Kunskap"; active: root.current-tab == 4; clicked => { root.current-tab = 4; } }
                    if root.settings.show_dev_logs : TabButton { icon: @image-url("../assets/icons/justify.svg"); text: "Loggar"; active: root.current-tab == 5; clicked => { root.current-tab = 5; root.request_logs(root.log-filter); } }
                }
            }
        }

        if root.show-folder-picker : Rectangle {
            background: #000000aa;
            FolderPicker {
                width: 90%;
                height: 80%;
                entries: root.folder-entries;
                current-path: root.current-folder-path;
                select-folder(p) => { root.select_folder(p); }
                create-folder(n) => { root.create_folder(root.current-folder-path, n); }
                go-back => { root.folder_go_back(); }
                cancel => { root.show-folder-picker = false; }
                confirm => { root.settings.sync_path = root.current-folder-path; root.show-folder-picker = false; }
            }
        }
    }
}
